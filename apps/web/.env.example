# ── Supabase (frontend — only the public/anon key goes here) ──────────────────
# Found in: Supabase Dashboard → Project Settings → API
# NEVER put the service_role key or JWT secret here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# ── Signaling Server ────────────────────────────────────────────────────────────
# Leave empty during local development (Vite proxy handles it)
# Set to your deployed server URL in production
VITE_SIGNALING_SERVER_URL=
