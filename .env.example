# ==============================================================================
# Call App - Environment Variables Configuration Template
# ==============================================================================

# Node Environment & Port (Render automatically sets PORT)
NODE_ENV=production
PORT=10000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Secret / Service Role Key (SERVER-SIDE ONLY - NEVER expose to client)
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Public / Publishable Anon Key (Safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ------------------------------------------------------------------------------
# WebRTC ICE / STUN / TURN Configuration
# ------------------------------------------------------------------------------
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN server (for symmetric NAT traversal)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
